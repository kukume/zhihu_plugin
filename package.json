{
  "name": "zhihu-plugin",
  "displayName": "知乎",
  "description": "在侧栏浏览知乎推荐、解码盐选，并在编辑器中阅读详情与评论",
  "version": "0.1.0",
  "publisher": "kuku",
  "repository": {
    "type": "git",
    "url": "https://github.com/kukume/zhihu_plugin.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "知乎",
      "properties": {
        "zhihu.cookie": {
          "type": "string",
          "default": "",
          "editPresentation": "multiline",
          "description": "知乎 Cookie（从浏览器复制登录后的 Cookie 头，如 z_c0=...; __zse_ck=...）"
        }
      }
    },
    "commands": [
      {
        "command": "zhihu.backRecommend",
        "title": "返回推荐列表",
        "icon": "$(arrow-left)"
      },
      {
        "command": "zhihu.refreshRecommend",
        "title": "刷新推荐",
        "icon": "$(refresh)"
      },
      {
        "command": "zhihu.openInEditor",
        "title": "在编辑器打开详情",
        "icon": "$(open-preview)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zhihu",
          "title": "知乎",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "zhihu": [
        {
          "type": "webview",
          "id": "zhihu.recommend",
          "name": "推荐",
          "retainContextWhenHidden": true
        },
        {
          "type": "webview",
          "id": "zhihu.decode",
          "name": "Decode",
          "retainContextWhenHidden": true
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "zhihu.backRecommend",
          "when": "view == zhihu.recommend && zhihu.recommendDetail",
          "group": "navigation@0"
        },
        {
          "command": "zhihu.refreshRecommend",
          "when": "view == zhihu.recommend && !zhihu.recommendDetail",
          "group": "navigation"
        },
        {
          "command": "zhihu.openInEditor",
          "when": "view == zhihu.recommend && zhihu.recommendDetail",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --out zhihu.vsix"
  },
  "dependencies": {
    "jsdom": "^30.1.1",
    "opentype.js": "^1.3.4",
    "qrcode": "^1.5.4",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/opentype.js": "^1.3.8",
    "@types/qrcode": "^1.5.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.7.2"
  }
}
