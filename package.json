{
  "name": "zhihu",
  "displayName": "zhihu",
  "description": "浏览知乎推荐、解码盐选，并在编辑器中阅读详情与评论",
  "version": "0.1.0",
  "publisher": "kukume",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kukume/zhihu_plugin.git"
  },
  "engines": {
    "vscode": "^1.123.0"
  },
  "extensionKind": [
    "ui"
  ],
  "license": "GPL-3.0-only",
  "categories": [
    "Other"
  ],
  "keywords": [
    "zhihu",
    "知乎",
    "reader",
    "feed",
    "盐选"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "扩展会携带登录 Cookie 访问知乎接口，不应在不受信任的工作区中运行。"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "知乎",
      "properties": {
        "zhihu.cookie": {
          "type": "string",
          "default": "",
          "scope": "application",
          "editPresentation": "multiline",
          "markdownDescription": "知乎 Cookie"
        },
        "zhihu.recommendPageSize": {
          "type": "number",
          "default": 6,
          "minimum": 6,
          "maximum": 60,
          "multipleOf": 6,
          "markdownDescription": "推荐流每次加载的条数，只能填 6 的倍数。"
        },
        "zhihu.otherAnswersPageSize": {
          "type": "number",
          "default": 3,
          "minimum": 3,
          "maximum": 60,
          "multipleOf": 3,
          "markdownDescription": "问题下「其他回答」每次加载的条数，只能填 3 的倍数。"
        }
      }
    },
    "commands": [
      {
        "command": "zhihu.backRecommend",
        "title": "返回推荐列表",
        "icon": "$(arrow-left)"
      },
      {
        "command": "zhihu.refreshRecommend",
        "title": "刷新推荐",
        "icon": "$(refresh)"
      },
      {
        "command": "zhihu.openInEditor",
        "title": "在编辑器打开详情",
        "icon": "$(open-preview)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zhihu",
          "title": "知乎",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "zhihu": [
        {
          "type": "webview",
          "id": "zhihu.recommend",
          "name": "推荐",
          "retainContextWhenHidden": true
        },
        {
          "type": "webview",
          "id": "zhihu.decode",
          "name": "Decode",
          "retainContextWhenHidden": true
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "zhihu.backRecommend",
          "when": "view == zhihu.recommend && zhihu.recommendDetail",
          "group": "navigation@0"
        },
        {
          "command": "zhihu.refreshRecommend",
          "when": "view == zhihu.recommend && !zhihu.recommendDetail",
          "group": "navigation"
        },
        {
          "command": "zhihu.openInEditor",
          "when": "view == zhihu.recommend && zhihu.recommendDetail",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --out zhihu.vsix"
  },
  "dependencies": {
    "jsdom": "^30.1.1",
    "opentype.js": "^1.3.4",
    "qrcode": "^1.5.4",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/opentype.js": "^1.3.8",
    "@types/qrcode": "^1.5.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.7.2"
  }
}
